# Local-development settings. `make` copies this file to .env on first use.
# Every value here is for local use only; a deployment must set its own.
# Keep the plain KEY=value format (no quotes, no $): both the Makefile and
# Docker Compose read .env.

# Postgres container (docker compose)
POSTGRES_USER=abtest
POSTGRES_PASSWORD=abtest-local-only
POSTGRES_DB=abtest
POSTGRES_PORT=5432

# Used by tests and tools running on your machine; containers build their own URL.
# If you change the values above, change this line to match.
DATABASE_URL=postgresql://abtest:abtest-local-only@localhost:5432/abtest
